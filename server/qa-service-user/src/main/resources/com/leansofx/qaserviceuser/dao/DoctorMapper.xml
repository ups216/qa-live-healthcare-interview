<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.leansofx.qaserviceuser.dao.DoctorMapper">

    <!-- ── ResultMap ───────────────────────────────────────── -->
    <resultMap id="DoctorResultMap" type="com.leansofx.qaserviceuser.entity.Doctor">
        <id     column="id"          property="id"/>
        <result column="username"    property="username"/>
        <result column="password"    property="password"/>
        <result column="name"        property="name"/>
        <result column="title"       property="title"/>
        <result column="department"  property="department"/>
        <result column="avatar"      property="avatar"/>
        <result column="experience"  property="experience"/>
        <result column="specialties" property="specialties"
                typeHandler="com.leansofx.qaserviceuser.typehandler.JsonStringListTypeHandler"/>
        <result column="is_active"   property="isActive"/>
        <result column="created_at"  property="createdAt"/>
        <result column="updated_at"  property="updatedAt"/>
    </resultMap>

    <!-- ── Column list ─────────────────────────────────────── -->
    <sql id="Base_Column_List">
        id, username, name, title, department, avatar, experience,
        CAST(specialties AS CHAR) AS specialties,
        is_active, created_at, updated_at
    </sql>

    <!-- ── findAll ─────────────────────────────────────────── -->
    <select id="findAll" resultMap="DoctorResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM doctors
        <where>
            <if test="isActive != null">
                AND is_active = #{isActive}
            </if>
        </where>
        ORDER BY is_active DESC, id ASC
    </select>

    <!-- ── findById ────────────────────────────────────────── -->
    <select id="findById" resultMap="DoctorResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM doctors
        WHERE id = #{id}
        LIMIT 1
    </select>

    <!-- ── findByUsername ──────────────────────────────────── -->
    <select id="findByUsername" resultMap="DoctorResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM doctors
        WHERE username = #{username}
        LIMIT 1
    </select>

</mapper>
