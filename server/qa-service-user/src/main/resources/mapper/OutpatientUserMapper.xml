<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.leansofx.qaserviceuser.mapper.OutpatientUserMapper">

    <resultMap id="OutpatientUserResultMap" type="com.leansofx.qaserviceuser.entity.OutpatientUser">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="gender" column="gender"/>
        <result property="birthday" column="birthday"/>
        <result property="status" column="status"/>
        <result property="lockUntil" column="lock_until"/>
        <result property="errorCount" column="error_count"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 根据用户名查询用户 -->
    <select id="selectByUsername" resultMap="OutpatientUserResultMap">
        SELECT id, username, password, name, phone, gender, birthday, 
               status, lock_until, error_count, create_time, update_time
        FROM outpatient_user
        WHERE username = #{username}
    </select>

    <!-- 根据ID查询用户 -->
    <select id="selectById" resultMap="OutpatientUserResultMap">
        SELECT id, username, password, name, phone, gender, birthday, 
               status, lock_until, error_count, create_time, update_time
        FROM outpatient_user
        WHERE id = #{id}
    </select>

    <!-- 更新错误次数和锁定时间 -->
    <update id="updateErrorCount">
        UPDATE outpatient_user 
        SET error_count = #{errorCount}, lock_until = #{lockUntil}, update_time = NOW() 
        WHERE id = #{id}
    </update>

    <!-- 重置错误次数 -->
    <update id="resetErrorCount">
        UPDATE outpatient_user 
        SET error_count = 0, update_time = NOW() 
        WHERE id = #{id}
    </update>

</mapper>
